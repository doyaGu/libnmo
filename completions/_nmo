_nmo_resolve_group() {
    case "$1" in
        f) echo 'file' ;;
        ch) echo 'chunk' ;;
        obj) echo 'object' ;;
        beh) echo 'behavior' ;;
        param) echo 'parameter' ;;
        res) echo 'resource' ;;
        tex) echo 'texture' ;;
        da) echo 'data' ;;
        sc) echo 'scene' ;;
        ent) echo 'entity' ;;
        mat) echo 'material' ;;
        m) echo 'mesh' ;;
        anim) echo 'animation' ;;
        t) echo 'type' ;;
        val) echo 'validate' ;;
        conv) echo 'convert' ;;
        d) echo 'diff' ;;
        q) echo 'query' ;;
        ext) echo 'extension' ;;
        comp) echo 'completion' ;;
        dbg) echo 'debug' ;;
        *) echo "$1" ;;
    esac
}

