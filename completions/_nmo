                'set-viewport:Set editor viewport'
                'set-graph-io:Set graph IO port ordering'
                'translate:Translate all positions'
            ) ;;
    esac
    _describe -t sub-actions 'sub-action' acts
}

_arguments -C $flags \
    '1:group:->group' \
    '2:action:->action' \
    '3:sub-action:->subaction' \
    '*:file:_files -g "*.{nmo,cmo,vmo,json,obj}"' && return

case "$state" in
    group)
        _describe -t groups 'command group' groups
        ;;
    action)
        local canonical
        canonical=$(_nmo_resolve_group "$line[1]")
        _nmo_actions "$canonical"
        ;;
    subaction)
        local canonical
        canonical=$(_nmo_resolve_group "$line[1]")
        _nmo_sub_actions "$canonical" "$line[2]"
        ;;
esac
