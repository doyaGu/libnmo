_nmo_sub_actions() {
    local -a acts
    case "$1/$2" in
        behavior/interface)
            acts=(
                'show:Show interface layout data'
                'set-pos:Move behavior position'
                'fold:Fold behavior'
                'unfold:Unfold behavior'
                'set-color:Set script color'
                'canonicalize:Rewrite interface chunk canonically'
                'add-comment:Add layout comment'
                'remove-comment:Remove layout comment'
                'set-comment-text:Set comment text'
                'move-comment:Move/resize comment'
                'set-comment-style:Set comment style flags'
                'add-point:Add link routing point'
                'clear-points:Clear link routing points'
                'remove-point:Remove link routing point'
                'move-point:Move link routing point'
                'set-link-highlight:Toggle link highlight'
                'move-op:Move operation position'
                'move-param:Move parameter grid position'
                'set-param-style:Set parameter style'
                'resize:Resize sub-behavior'
                'set-expand:Set expand size'
                'set-viewport:Set editor viewport'
                'set-graph-io:Set graph IO port ordering'
                'translate:Translate all positions'
            ) ;;
        behavior/iface)
            acts=(
                'show:Show interface layout data'
                'set-pos:Move behavior position'
                'fold:Fold behavior'
                'unfold:Unfold behavior'
                'set-color:Set script color'
                'canonicalize:Rewrite interface chunk canonically'
