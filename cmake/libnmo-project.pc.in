prefix=${pcfiledir}/../..
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: libnmo-project
Description: Project authoring layer for libnmo
Version: @PROJECT_VERSION@
Requires: libnmo = @PROJECT_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} @NMO_PROJECT_PC_LIBS@
