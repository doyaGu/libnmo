prefix=${pcfiledir}/../..
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: libnmo-edit
Description: Edit plans, script edits and behavior rewrites for libnmo
Version: @PROJECT_VERSION@
Requires: libnmo = @PROJECT_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} @NMO_EDIT_PC_LIBS@
