prefix=${pcfiledir}/../..
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: libnmo
Description: Read and write Virtools composition files
Version: @PROJECT_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -lnmo @NMO_PC_LIBS@
Libs.private: @NMO_PC_LIBS_PRIVATE@
